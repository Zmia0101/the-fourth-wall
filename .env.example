# 复制这个文件为 .env，再按需要修改
#
# 说明：当前版本里，对话、群聊、生成摘要都只使用「用户自己在网页设置里填的 API Key」，
# 所以下面的 LLM_API_KEY 留空即可，不会产生平台方的费用。

# 用户没有填自己的 Base URL / 模型时，用这里兜底
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 全局 API Key：当前版本已不再使用，留空
LLM_API_KEY=

# （可选）给用户 API Key 加密用的独立密钥
# 填一长串随机字符，可以让你就算 data/users.json 泄露，别人也解不出用户的 Key
LLM_ENCRYPTION_KEY=
